<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj-mod/**;bin-mod/**</DefaultItemExcludes>
  </PropertyGroup>
  <Import Project="../../../src/DynastyRetinue/local.props" Condition="Exists('../../../src/DynastyRetinue/local.props')" />
  <PropertyGroup>
    <GameManaged Condition="'$(GameManaged)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Warhammer 40,000 Rogue Trader\WH40KRT_Data\Managed</GameManaged>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../src/DynastyRetinue/GuardGrowth.cs" Link="GuardGrowth.cs" />
    <Compile Include="../../../src/DynastyRetinue/GuardGrowthStore.cs" Link="GuardGrowthStore.cs" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameManaged)/Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameManaged)/0Harmony.dll</HintPath></Reference>
  </ItemGroup>
</Project>
