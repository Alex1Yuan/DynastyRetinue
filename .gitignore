# 构建产物
bin/
obj/
*.dll.*.cache
*.dll.*.cache.pdb

# ── ref/ 是分析工作区：反编译源码、蓝图索引、各种 dump，共 168MB。
#    全部可以从游戏重新生成，不入库；只保留笔记和分析脚本（见末尾取反规则）。
ref/*
!ref/*.md
!ref/rt_probe/
ref/rt_probe/*
!ref/rt_probe/*.py
!ref/bbp/
ref/bbp/*
!ref/bbp/Program.cs
!ref/bbp/bbp.csproj

# 存档备份（含个人存档）
savebackup_*/

# 游戏内导出的大表，可由 mod 面板按钮重新导出
*_zh.tsv
items.tsv
features.tsv
armor_rank.tsv
autotest.tsv

# 工作流 agent 的反编译产物（并发写入，别让 git 去索引）
_tmp/lance/
_tmp/hull/
dist/

# archetypes.json 的临时回滚点（改配表前 cp 一份，纯本地安全网）
src/KgdRetinue/archetypes.json.pre-*
# src 下划线开头的是一次性排查脚本，不入库
src/KgdRetinue/_*.py

# 发布物料（截图/录屏，体积大且是二进制）与本机 mod 目录备份
_press/*
!_press/*.md
_backup/

# Remotion 的 agent skills（做宣传视频用的第三方工具，跟 mod 本身无关）
.agents/
.claude/skills/
skills-lock.json
